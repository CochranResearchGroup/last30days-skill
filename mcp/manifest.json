{
  "manifest_version": "0.3",
  "name": "last30days-pp-mcp",
  "display_name": "Last30Days",
  "version": "4.0.4",
  "description": "Discover and query the local cache-backed Last30Days intelligence service without exposing browser or scraper mechanics.",
  "author": {
    "name": "Matt Van Horn",
    "url": "https://github.com/mvanhorn/last30days-skill"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mvanhorn/last30days-skill"
  },
  "license": "MIT",
  "keywords": [
    "research",
    "reddit",
    "twitter",
    "x",
    "youtube",
    "hacker-news",
    "polymarket",
    "github",
    "search",
    "synthesis"
  ],
  "server": {
    "type": "binary",
    "entry_point": "bin/last30days-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/last30days-pp-mcp",
      "args": [],
      "env": {
        "LAST30DAYS_SERVICE_SOCKET": "${user_config.last30days_service_socket}"
      }
    }
  },
  "user_config": {
    "last30days_service_socket": {
      "type": "string",
      "title": "Last30Days service socket",
      "description": "Absolute path to the user-scoped Last30Days Unix socket. Leave empty when XDG_RUNTIME_DIR is available.",
      "sensitive": false,
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "linux"
    ]
  }
}
