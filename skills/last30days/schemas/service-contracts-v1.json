{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "last30days intelligence service contract catalog",
  "schema_version": 1,
  "compatibility": {
    "product": "last30days",
    "service_api": {"min": 1, "max": 1},
    "database_schema": {"min": 13, "max": 13}
  },
  "contracts": {
    "tick_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schedule_id",
        "interval_from",
        "interval_to",
        "trigger"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "schedule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "interval_from": {"type": "string", "format": "date-time"},
        "interval_to": {"type": "string", "format": "date-time"},
        "trigger": {"type": "string", "enum": ["manual", "timer"]}
      }
    },
    "tick_lane_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "lane_id",
        "service_id",
        "target_id",
        "access_partition_id",
        "state"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "lane_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "service_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "access_partition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "success",
            "empty",
            "unsupported",
            "failure",
            "blocked_human",
            "budget_exhausted"
          ]
        }
      }
    },
    "tick_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tick_id",
        "schedule_id",
        "interval_from",
        "interval_to",
        "trigger",
        "config_revision",
        "config_digest",
        "state",
        "execution_attempt_ids",
        "lanes",
        "stage_states",
        "budget_summary",
        "provider_attempt_ids",
        "resource_lease_ids",
        "source_version_ids",
        "incident_ids",
        "incident_transition_ids",
        "notification_delivery_ids",
        "anomaly_result_ids",
        "artifact_ids",
        "derivative_ids",
        "catalog_cluster_ids",
        "snapshot_id",
        "head_promoted",
        "manifest_digests",
        "receipt_manifests",
        "coverage_gaps",
        "versions",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "tick_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "schedule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "interval_from": {"type": "string", "format": "date-time"},
        "interval_to": {"type": "string", "format": "date-time"},
        "trigger": {"type": "string", "enum": ["manual", "timer"]},
        "config_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "preflight",
            "collecting",
            "analyzing",
            "cataloging",
            "indexing",
            "complete",
            "complete_degraded",
            "failed",
            "missed_due_to_overlap"
          ]
        },
        "execution_attempt_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "lanes": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/contracts/tick_lane_receipt"}
        },
        "stage_states": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "budget_summary": {"type": "object"},
        "provider_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "resource_lease_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "source_version_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "incident_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "incident_transition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "notification_delivery_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "anomaly_result_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "derivative_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "catalog_cluster_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "snapshot_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "head_promoted": {"type": "boolean"},
        "manifest_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "receipt_manifests": {"type": "object"},
        "coverage_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "versions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "temporal_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_id",
        "document_id",
        "version_id",
        "chunk_id",
        "access_partition_id",
        "span_start",
        "span_end",
        "span_digest",
        "observed_at",
        "published_at",
        "valid_from",
        "valid_to",
        "system_from",
        "system_to"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "chunk_id": {"type": "string", "minLength": 1},
        "access_partition_id": {"type": "string", "minLength": 1},
        "span_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "span_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "span_digest": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_to": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "system_from": {"type": "string", "format": "date-time"},
        "system_to": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "query_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "profile_id",
        "query",
        "freshness_policy",
        "response_mode",
        "filters",
        "top_k",
        "max_chars",
        "wait_ms"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "freshness_policy": {
          "type": "string",
          "enum": [
            "cache_only",
            "prefer_cache",
            "refresh_if_stale",
            "force_refresh"
          ]
        },
        "response_mode": {
          "type": "string",
          "enum": ["evidence", "brief"]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sources": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "topic_ids": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "published_after": {"type": "string", "minLength": 1},
            "published_before": {"type": "string", "minLength": 1}
          }
        },
        "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_chars": {"type": "integer", "minimum": 512, "maximum": 65536},
        "wait_ms": {"type": "integer", "minimum": 0, "maximum": 300000}
      }
    },
    "intelligence_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "profile_id"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "temporal_query",
            "profile_history",
            "coverage",
            "collection",
            "maintenance_status"
          ]
        },
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "query": {"type": "string", "minLength": 1, "maxLength": 4096},
        "response_mode": {
          "type": "string",
          "enum": [
            "evidence",
            "brief",
            "timeline",
            "entity_dossier",
            "event_dossier",
            "trend",
            "comparison"
          ]
        },
        "as_of": {"type": "string", "minLength": 1, "maxLength": 64},
        "during_from": {"type": "string", "minLength": 1, "maxLength": 64},
        "during_to": {"type": "string", "minLength": 1, "maxLength": 64},
        "known_as_of": {"type": "string", "minLength": 1, "maxLength": 64},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "handle": {"type": "string", "minLength": 1, "maxLength": 256},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "operation": {
          "type": "string",
          "enum": ["list", "put", "pause", "resume", "run"]
        },
        "spec": {"$ref": "#/contracts/collection_spec"},
        "collection_spec_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scheduled_for": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "query_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "index_version",
        "cache_status",
        "generated_at",
        "evidence",
        "brief",
        "job_id",
        "diagnostics_available",
        "truncated",
        "next_cursor"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "index_version": {"type": "string", "minLength": 1},
        "cache_status": {
          "type": "string",
          "enum": ["fresh", "stale", "miss"]
        },
        "generated_at": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/contracts/evidence_item"}
        },
        "brief": {"type": ["string", "null"]},
        "job_id": {"type": ["string", "null"]},
        "diagnostics_available": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"]}
      }
    },
    "service_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product",
        "service_version",
        "service_api_version",
        "contract_schema_version",
        "contract_sha256",
        "database_schema_version",
        "runtime_manifest_sha256",
        "mcp_adapter_version",
        "mcp_supported_service_api_min",
        "mcp_supported_service_api_max",
        "mcp_supported_database_schema_min",
        "mcp_supported_database_schema_max",
        "compatibility_state",
        "status",
        "capabilities",
        "sources",
        "freshness_policies",
        "response_modes",
        "limits",
        "index",
        "transport"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "product": {"const": "last30days"},
        "service_version": {"type": "string", "minLength": 1},
        "service_api_version": {"type": "integer", "minimum": 1},
        "contract_schema_version": {"type": "integer", "minimum": 1},
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "database_schema_version": {"type": "integer", "minimum": 1},
        "runtime_manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "mcp_adapter_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "mcp_supported_service_api_min": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "mcp_supported_service_api_max": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "mcp_supported_database_schema_min": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "mcp_supported_database_schema_max": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "compatibility_state": {
          "type": "string",
          "enum": [
            "compatible",
            "mcp_client_not_declared",
            "product_mismatch",
            "service_api_unsupported",
            "contract_schema_unsupported",
            "contract_digest_mismatch",
            "database_schema_unsupported",
            "runtime_manifest_invalid",
            "handshake_invalid"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["starting", "ready", "degraded"]
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "sources": {"type": "object"},
        "freshness_policies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cache_only",
              "prefer_cache",
              "refresh_if_stale",
              "force_refresh"
            ]
          }
        },
        "response_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["evidence", "brief"]
          }
        },
        "limits": {"type": "object"},
        "index": {"type": "object"},
        "transport": {"const": "unix"}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_id",
        "document_id",
        "source",
        "source_native_id",
        "url",
        "title",
        "snippet",
        "author",
        "published_at",
        "fetched_at",
        "acquisition_id",
        "content_hash",
        "scores"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_native_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "snippet": {"type": "string", "minLength": 1},
        "author": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "fetched_at": {"type": "string", "minLength": 1},
        "acquisition_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1},
        "media": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "url",
              "preview_url",
              "mime_type",
              "width",
              "height",
              "duration_seconds",
              "alt_text"
            ],
            "properties": {
              "kind": {"enum": ["image", "video"]},
              "url": {"type": "string", "minLength": 1, "maxLength": 4096},
              "preview_url": {"type": ["string", "null"]},
              "mime_type": {"type": ["string", "null"]},
              "width": {"type": ["integer", "null"], "minimum": 0},
              "height": {"type": ["integer", "null"], "minimum": 0},
              "duration_seconds": {"type": ["integer", "null"], "minimum": 0},
              "alt_text": {"type": ["string", "null"]}
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lexical", "semantic", "graph", "recency", "fused"],
          "properties": {
            "lexical": {"type": "number", "minimum": 0, "maximum": 1},
            "semantic": {"type": "number", "minimum": 0, "maximum": 1},
            "graph": {"type": "number", "minimum": 0, "maximum": 1},
            "recency": {"type": "number", "minimum": 0, "maximum": 1},
            "fused": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "acquisition_work_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work_id",
        "job_id",
        "lease_generation",
        "attempt",
        "profile_id",
        "source",
        "query",
        "from_date",
        "to_date",
        "depth",
        "adapter",
        "adapter_version",
        "wall_timeout_seconds",
        "item_limit",
        "network_request_limit",
        "cost_budget_cents"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "query": {"type": "string", "minLength": 1, "maxLength": 8192},
        "from_date": {"type": "string", "minLength": 1, "maxLength": 64},
        "to_date": {"type": "string", "minLength": 1, "maxLength": 64},
        "depth": {"type": "string", "enum": ["quick", "standard", "deep"]},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "wall_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "item_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "network_request_limit": {"type": "integer", "minimum": 0, "maximum": 100000},
        "cost_budget_cents": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "acquisition_work_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work_id",
        "job_id",
        "lease_generation",
        "source",
        "adapter",
        "adapter_version",
        "status",
        "safe_error_code",
        "retry_class",
        "retry_after_seconds",
        "observed_at",
        "fetched_at",
        "items",
        "item_count",
        "cost_cents",
        "diagnostics"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {
          "type": "string",
          "enum": ["succeeded", "partial", "failed", "awaiting_operator"]
        },
        "safe_error_code": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "retry_class": {
          "type": "string",
          "enum": [
            "none",
            "operator",
            "rate_limit",
            "transient",
            "configuration",
            "content",
            "permanent"
          ]
        },
        "retry_after_seconds": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "items": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_native_id",
              "url",
              "title",
              "text",
              "author",
              "published_at",
              "metadata"
            ],
            "properties": {
              "source_native_id": {"type": "string", "minLength": 1, "maxLength": 512},
              "url": {"type": "string", "minLength": 1, "maxLength": 4096},
              "title": {"type": "string", "minLength": 1, "maxLength": 2048},
              "text": {"type": "string", "minLength": 1, "maxLength": 65536},
              "author": {"type": ["string", "null"]},
              "published_at": {"type": ["string", "null"]},
              "metadata": {"type": "object"}
            }
          }
        },
        "item_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "network_request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "attempted_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "observed_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "accepted_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "rejected_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "cost_cents": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "diagnostics": {"type": "object"}
      }
    },
    "entity_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "document_id",
        "evidence_chunk_id",
        "canonical_name",
        "entity_type",
        "evidence_start",
        "evidence_end",
        "extractor_version",
        "confidence"
      ],
      "properties": {
