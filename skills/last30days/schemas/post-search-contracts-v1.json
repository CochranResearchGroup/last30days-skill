{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "last30days post search contract catalog",
  "schema_version": 1,
  "contracts": {
    "post_search_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "profile_id",
        "query",
        "filters",
        "page_size",
        "cursor"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[A-Za-z0-9]"
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "published_after": {"type": "string", "format": "date-time"},
            "published_before": {"type": "string", "format": "date-time"}
          }
        },
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    },
    "post_search_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_family", "version_id", "content_hash", "source_url"],
      "properties": {
        "storage_family": {"type": "string", "enum": ["legacy", "temporal"]},
        "version_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_url": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "post_search_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_id",
        "revision_id",
        "storage_family",
        "source",
        "source_native_id",
        "url",
        "title",
        "author",
        "text",
        "published_at",
        "observed_at",
        "access_partition_id",
        "score",
        "matching_channels",
        "evidence_ref"
      ],
      "properties": {
        "post_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "storage_family": {"type": "string", "enum": ["legacy", "temporal"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_native_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "url": {"type": "string", "minLength": 1, "maxLength": 4096},
        "title": {"type": "string", "minLength": 1, "maxLength": 4096},
        "author": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "access_partition_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "matching_channels": {"const": ["lexical"]},
        "evidence_ref": {"$ref": "#/contracts/post_search_evidence_ref"}
      }
    },
    "post_search_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "search_head_id",
        "generated_at",
        "query",
        "filters",
        "sort",
        "revision_mode",
        "hits",
        "returned",
        "truncated",
        "next_cursor",
        "coverage"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "search_head_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generated_at": {"type": "string", "format": "date-time"},
        "query": {"type": "string", "minLength": 1, "maxLength": 4096},
        "filters": {"$ref": "#/contracts/post_search_request/properties/filters"},
        "sort": {"const": "relevance"},
        "revision_mode": {"const": "current"},
        "hits": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/contracts/post_search_hit"}
        },
        "returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "truncated": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "coverage": {"type": "object"}
      }
    }
  }
}
