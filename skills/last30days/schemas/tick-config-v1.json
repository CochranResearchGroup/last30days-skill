{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "last30days://schemas/tick-config-v1.json",
  "title": "last30days durable tick configuration",
  "description": "User-scoped, non-secret configuration frozen by each durable tick.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_revision",
    "services",
    "targets",
    "tick",
    "artifacts",
    "analysis",
    "notifications",
    "query"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "config_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/service"}
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/target"}
    },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "lateness_seconds", "aggregate_limits"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1, "maxLength": 128},
        "lateness_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "aggregate_limits": {"$ref": "#/$defs/limits"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "retention_days", "encryption_adapter"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 36500},
        "encryption_adapter": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocr_enabled",
        "ocr_adapter_type",
        "semantic_sidecars_enabled",
        "semantic_sidecar_adapter_type"
      ],
      "properties": {
        "ocr_enabled": {"type": "boolean"},
        "ocr_adapter_type": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "semantic_sidecars_enabled": {"type": "boolean"},
        "semantic_sidecar_adapter_type": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "anomaly_rules": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/anomaly_rule"}
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transports", "reminder_seconds"],
      "properties": {
        "transports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/notification_transport"}
        },
        "reminder_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_type", "service_base_url"],
      "properties": {
        "adapter_type": {"const": "agent_browser_service"},
        "service_base_url": {
          "type": "string",
          "pattern": "^https?://",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding_space", "fusion_version"],
      "properties": {
        "embedding_space": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fusion_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "network_requests",
        "wall_seconds",
        "items",
        "cost_cents",
        "model_tokens"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
        "network_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "items": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "cost_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "adapter_type",
        "resource_keys",
        "fallback_on",
        "limits"
      ],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "credential_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource_keys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "fallback_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "source", "providers"],
      "properties": {
        "service_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/provider"}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "service_id",
        "surface_kind",
        "selector",
        "access_partition_id",
        "retention_class",
        "enabled"
      ],
      "properties": {
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "service_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "surface_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "selector": {"type": "object", "maxProperties": 32},
        "access_partition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retention_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {"type": "boolean"}
      }
    },
    "notification_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_id",
        "adapter_type",
        "credential_ref",
        "routing"
      ],
      "properties": {
        "transport_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "credential_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "routing": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "anomaly_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "metric",
        "direction",
        "minimum_comparable_ticks",
        "warning_ratio",
        "critical_ratio"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 48},
        "metric": {
          "enum": [
            "yield_count",
            "rejection_rate",
            "latency_seconds",
            "missing_media_rate"
          ]
        },
        "direction": {"enum": ["low", "high"]},
        "minimum_comparable_ticks": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "warning_ratio": {"type": "number", "exclusiveMinimum": 0},
        "critical_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
