{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "last30days question and immutable evidence contracts",
  "schema_version": 1,
  "contracts": {
    "question_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "profile_id", "question", "filters", "temporal", "answer_mode", "model_fallback", "limits"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "filters": {"type": "object"},
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["as_of", "during_from", "during_to", "known_as_of"],
          "properties": {
            "as_of": {"type": ["string", "null"], "format": "date-time"},
            "during_from": {"type": ["string", "null"], "format": "date-time"},
            "during_to": {"type": ["string", "null"], "format": "date-time"},
            "known_as_of": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "answer_mode": {"enum": ["synthesized", "evidence_only"]},
        "model_fallback": {"enum": ["none", "evidence_only"]},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_limit", "max_evidence_bytes", "max_answer_characters", "max_statements", "wait_ms", "max_evidence_age_seconds", "max_attempts"],
          "properties": {
            "evidence_limit": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_evidence_bytes": {"type": "integer", "minimum": 512, "maximum": 131072},
            "max_answer_characters": {"type": "integer", "minimum": 1, "maximum": 32768},
            "max_statements": {"type": "integer", "minimum": 1, "maximum": 50},
            "wait_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
            "max_evidence_age_seconds": {"type": ["integer", "null"], "minimum": 1},
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2}
          }
        }
      }
    },
    "question_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "question_id", "state", "attempt_count", "max_attempts", "lease_generation", "lease_expires_at", "answer", "error"],
      "properties": {
        "schema_version": {"const": 1},
        "question_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "state": {"enum": ["pending", "running", "answered", "no_evidence", "insufficient_evidence", "conflicting_evidence", "model_unavailable", "failed"]},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "lease_generation": {"type": "integer", "minimum": 0},
        "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
        "answer": {"type": ["object", "null"]},
        "error": {"type": ["object", "null"]}
      }
    },
    "evidence_read_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "profile_id", "refs", "max_response_bytes"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "object"}},
        "max_response_bytes": {"type": "integer", "minimum": 512, "maximum": 131072}
      }
    },
    "evidence_read_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "items", "omitted_refs", "truncated", "response_bytes"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "items": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
        "omitted_refs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "truncated": {"type": "boolean"},
        "response_bytes": {"type": "integer", "minimum": 2, "maximum": 131072}
      }
    }
  }
}
